# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=coloque-a-publishable-key-aqui
SUPABASE_SECRET_KEY=coloque-a-secret-key-aqui   # NUNCA exponha no client

# URL pública da sua aplicação (usada no QR Code e nos links de validação)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mail transacional (Resend - resend.com, free tier 3k emails/mês)
RESEND_API_KEY=coloque-sua-api-key-aqui
